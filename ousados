<script>
    // Mobile Navigation Toggle
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    menuBtn.addEventListener('click', toggleMobileMenu);

    function toggleMobileMenu() {
        mobileMenu.classList.toggle('hidden');
    }

    // Squad Filtering Algorithm
    function filterPlayers(category) {
        const buttons = document.querySelectorAll('.player-filter-btn');
        buttons.forEach(btn => {
            btn.classList.remove('bg-gold', 'text-wine-dark');
            btn.classList.add('bg-wine', 'text-white', 'border', 'border-gold/40');
        });

        if (event && event.target) {
            event.target.classList.remove('bg-wine', 'text-white', 'border', 'border-gold/40');
            event.target.classList.add('bg-gold', 'text-wine-dark');
        }

        const cards = document.querySelectorAll('.player-card');
        cards.forEach(card => {
            if (category === 'all' || card.dataset.category === category) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }

    // Contact / Message Submission Handler
    function enviarSalve() {
        const nome = document.getElementById('input-nome').value.trim();
        const whats = document.getElementById('input-whats').value.trim();

        if (!nome || !whats) {
            openModal("Por favor, preencha seu nome/apelido e o WhatsApp para entrar na resenha!");
            return;
        }

        openModal(`Valeu, ${nome}! Seu contato foi enviado com sucesso. Entraremos em contato no WhatsApp para colar no próximo jogo ou combinar aquele desafio!`);
        document.getElementById('input-nome').value = '';
        document.getElementById('input-whats').value = '';
    }

    // Custom Modal Control System
    function openModal(message) {
        const modal = document.getElementById('custom-modal');
        const msgEl = document.getElementById('modal-message');
        msgEl.textContent = message;
        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
        }, 10);
    }

    function closeModal() {
        const modal = document.getElementById('custom-modal');
        modal.classList.add('opacity-0');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 300);
    }
</script>

